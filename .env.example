# Server-only database connection. Use the Supabase transaction pooler on Vercel.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Server-side Supabase Auth and Storage configuration.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=payment-screenshots

# Public browser Supabase Auth configuration, embedded at build time.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# Legacy compatibility names are still accepted by the current code.
# SUPABASE_ANON_KEY=<supabase-anon-key>
# VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# Server session and administrator allowlists.
SESSION_SECRET=<generate-a-random-secret>
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_PHONE_NUMBERS=<phone-number>,<phone-number>
ADMIN_PASSWORD_RESET_REDIRECT_URL=https://undergraduate-hub-library-v1-mr0mrxigz.vercel.app/admin/reset-password

# Phone OTP provider.
SMS_API_BASE_URL=https://swiftsms.astgd.com/api/sms/send
SMS_API_KEY=<sms-provider-api-key>
SMS_API_LABEL=transactional

# App origin used by server-generated links.
APP_ORIGIN=https://undergraduate-hub-library-v1-mr0mrxigz.vercel.app

# Optional local Supabase SMTP settings; configure hosted SMTP in Supabase.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
EMAIL_FROM=admin@example.com
EMAIL_SENDER_NAME=Undergraduate Hub