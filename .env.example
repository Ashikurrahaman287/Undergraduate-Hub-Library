# Database used by the API. Vercel must point this at the production database.
DATABASE_URL=postgresql://...

# Supabase Auth and Admin API. Keep the service role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=payment-screenshots

# Public Supabase Auth settings embedded in the frontend at build time.
# The anon/publishable key is public; never use the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Session and administrator setup.
SESSION_SECRET=generate-a-long-random-secret
ADMIN_PHONE_NUMBER=01XXXXXXXXX
ADMIN_INITIAL_EMAIL=undergraduate_hub@yahoo.com
ADMIN_PASSWORD_RESET_REDIRECT_URL=https://your-production-domain.example/admin/reset-password

# Phone OTP provider.
SMS_API_BASE_URL=https://swiftsms.astgd.com/api/sms/send
SMS_API_KEY=your-sms-provider-key
SMS_API_LABEL=transactional

# Used by the local Supabase SMTP configuration. For hosted Supabase,
# configure the same values in Authentication > SMTP Settings instead.
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=587
SMTP_USER=undergraduate_hub
SMTP_PASSWORD=your-yahoo-app-password
EMAIL_FROM=undergraduate_hub@yahoo.com
EMAIL_SENDER_NAME=Undergraduate Hub

# Optional when the API is called from a different origin.
APP_ORIGIN=https://your-production-domain.example