# Development database used by the current workspace
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase production configuration for the Vercel API function. Keep all values server-side.
# Replit development can use the managed Supabase connector instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_ORIGIN=https://your-production-domain.example
ADMIN_PASSWORD_RESET_REDIRECT_URL=https://your-production-domain.example/admin/reset-password

# One-time administrator provisioning. Remove or rotate both after provisioning.
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-value
ADMIN_PHONE_NUMBER=01619617036

# Server-only member OTP delivery
SMS_API_BASE_URL=https://your-sms-provider.example/send
SMS_API_KEY=replace-with-provider-secret
SMS_API_LABEL=transactional

# Server-side session signing secret
SESSION_SECRET=replace-with-a-long-random-value

# Vercel build settings are already defined in vercel.json.
# Required Vercel production variables:
# DATABASE_URL, SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# SESSION_SECRET, SMS_API_KEY, ADMIN_PHONE_NUMBER