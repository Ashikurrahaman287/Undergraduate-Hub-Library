# Backend-only environment variables
# These should NEVER be exposed to the frontend

# Supabase Backend Configuration (Service Role - DO NOT EXPOSE)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL Connection (if using direct connection instead of Supabase)
DATABASE_URL=postgresql://postgres:password@your-project.supabase.co:5432/postgres

# JWT & Security
JWT_SECRET=your-jwt-secret-key-min-32-chars-recommended

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration
CORS_ORIGIN=https://your-vercel-domain.vercel.app

# Logging
LOG_LEVEL=info
