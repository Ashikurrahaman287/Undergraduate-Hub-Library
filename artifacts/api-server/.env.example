# Backend-only environment variables. Never expose these with a VITE_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Legacy compatibility names may be used instead of the names above.
# SUPABASE_ANON_KEY=<supabase-anon-key>

# Use the Supabase Transaction Pooler connection string in Vercel.
DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:<port>/<database>
SESSION_SECRET=<generate-a-random-secret>
SUPABASE_STORAGE_BUCKET=payment-screenshots
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_PHONE_NUMBERS=<phone-number>,<phone-number>
ADMIN_PASSWORD_RESET_REDIRECT_URL=https://undergraduate-hub-library-v1-mr0mrxigz.vercel.app/admin/reset-password
APP_ORIGIN=https://undergraduate-hub-library-v1-mr0mrxigz.vercel.app
SMS_API_BASE_URL=https://swiftsms.astgd.com/api/sms/send
SMS_API_KEY=<sms-provider-api-key>
SMS_API_LABEL=transactional

# Optional local SMTP settings; configure hosted Supabase SMTP separately.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
EMAIL_FROM=admin@example.com
EMAIL_SENDER_NAME=Undergraduate Hub
