# Backend-only environment variables. Never expose these with a VITE_ prefix.
SUPABASE_URL=https://znhaqyuhxydnjijbkzza.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy compatibility names may be used instead of the names above.
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Use the Supabase Transaction Pooler connection string in Vercel.
DATABASE_URL=postgresql://postgres.znhaqyuhxydnjijbkzza:password@aws-0-region.pooler.supabase.com:6543/postgres
SESSION_SECRET=generate-a-long-random-secret
SUPABASE_STORAGE_BUCKET=payment-screenshots
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_PASSWORD_RESET_REDIRECT_URL=https://undergraduate-hub-library-v1-mr0mrxigz.vercel.app/admin/reset-password
APP_ORIGIN=https://undergraduate-hub-library-v1-mr0mrxigz.vercel.app
SMS_API_BASE_URL=https://swiftsms.astgd.com/api/sms/send
SMS_API_KEY=your-sms-provider-key
